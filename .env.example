# Copy to .env (never committed): cp .env.example .env

# Postgres for host-side runs (docker compose overrides it with the in-network `db` host).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/recipe

# Primary LLM provider: gemini | groq.
LLM_PROVIDER=gemini
# Optional second provider (must differ from LLM_PROVIDER; empty = none).
LLM_FALLBACK_PROVIDER=

# Google AI Studio key, free tier, no card — https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Groq key, free, no card — https://console.groq.com/keys (needed only for the fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Timeout of one LLM HTTP attempt, seconds.
LLM_TIMEOUT_SECONDS=45

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
